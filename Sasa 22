          cat > app/src/main/java/com/lanchat/Net.kt <<'LANCHAT_EOF'
          package com.lanchat

          import android.content.Context
          import android.net.wifi.WifiManager
          import java.net.DatagramPacket
          import java.net.DatagramSocket
          import java.net.InetAddress
          import java.net.NetworkInterface
          import java.util.UUID
          import kotlin.concurrent.thread

          object Net {
              const val UDP_PORT = 45678
              const val TCP_PORT = 45679
              const val SEP = "\u0001"
              const val MAGIC = "LANCHAT2"

              val myId: String = UUID.randomUUID().toString().replace("-", "").take(8)

              fun newId(): String = UUID.randomUUID().toString().replace("-", "").take(16)

              fun packet(msgId: String, kind: String, name: String, payload: String): ByteArray {
                  return listOf(MAGIC, msgId, myId, kind, name, payload)
                      .joinToString(SEP)
                      .toByteArray(Charsets.UTF_8)
              }

              fun broadcast(ctx: Context, data: ByteArray) {
                  val app = ctx.applicationContext
                  thread(isDaemon = true) {
                      try {
                          DatagramSocket().use { s ->
                              s.broadcast = true
                              repeat(2) {
                                  for (addr in broadcastAddresses(app)) {
                                      try {
                                          s.send(DatagramPacket(data, data.size, addr, UDP_PORT))
                                      } catch (_: Exception) {
                                      }
                                  }
                                  Thread.sleep(150)
                              }
                          }
                      } catch (_: Exception) {
                      }
                  }
              }

              @Suppress("DEPRECATION")
              fun broadcastAddresses(ctx: Context): List<InetAddress> {
                  val out = LinkedHashSet<InetAddress>()
                  try {
                      val nis = NetworkInterface.getNetworkInterfaces()?.toList() ?: emptyList()
                      for (ni in nis) {
                          if (!ni.isUp || ni.isLoopback) continue
                          for (ia in ni.interfaceAddresses) {
                              val b = ia.broadcast
                              if (b != null) out.add(b)
                          }
                      }
                  } catch (_: Exception) {
                  }
                  try {
                      val wm = ctx.getSystemService(Context.WIFI_SERVICE) as WifiManager
                      val d = wm.dhcpInfo
                      if (d != null && d.ipAddress != 0) {
                          val b = (d.ipAddress and d.netmask) or d.netmask.inv()
                          val bytes = ByteArray(4) { i -> ((b shr (8 * i)) and 0xff).toByte() }
                          out.add(InetAddress.getByAddress(bytes))
                      }
                  } catch (_: Exception) {
                  }
                  try {
                      out.add(InetAddress.getByName("255.255.255.255"))
                  } catch (_: Exception) {
                  }
                  return out.toList()
              }
          }
          LANCHAT_EOF
          mkdir -p app/src/main/java/com/lanchat
          cat > app/src/main/java/com/lanchat/Store.kt <<'LANCHAT_EOF'
          package com.lanchat

          import android.content.Context
          import java.io.File
          import java.text.SimpleDateFormat
          import java.util.Date
          import java.util.Locale

          data class Msg(
              val mine: Boolean,
              val name: String,
              val text: String,
              val imgId: String,
              val time: String
          )

          object Store {
              private fun file(ctx: Context): File = File(ctx.filesDir, "chat.log")

              fun now(): String = SimpleDateFormat("HH:mm", Locale.getDefault()).format(Date())

              @Synchronized
              fun append(ctx: Context, m: Msg) {
                  val fields = listOf(if (m.mine) "1" else "0", m.name, m.time, m.imgId, m.text)
                  val line = fields.joinToString(Net.SEP) {
                      it.replace("\n", "\u0002").replace(Net.SEP, " ")
                  } + "\n"
                  file(ctx).appendText(line, Charsets.UTF_8)
              }

              @Synchronized
              fun load(ctx: Context, max: Int = 200): List<Msg> {
                  val f = file(ctx)
                  if (!f.exists()) return emptyList()
                  val out = ArrayList<Msg>()
                  for (line in f.readLines(Charsets.UTF_8).takeLast(max)) {
                      val p = line.split(Net.SEP, limit = 5)
                      if (p.size == 5) {
                          out.add(Msg(p[0] == "1", p[1], p[4].replace("\u0002", "\n"), p[3], p[2]))
                      }
                  }
                  return out
              }
          }
