          mkdir -p app/src/main/java/com/lanchat
          cat > app/src/main/java/com/lanchat/ChatService.kt <<'LANCHAT_EOF'
          package com.lanchat

          import android.app.Notification
          import android.app.NotificationChannel
          import android.app.NotificationManager
          import android.app.PendingIntent
          import android.app.Service
          import android.content.Context
          import android.content.Intent
          import android.content.pm.ServiceInfo
          import android.net.wifi.WifiManager
          import android.os.Build
          import android.os.IBinder
          import android.os.PowerManager
          import java.io.File
          import java.io.FileOutputStream
          import java.net.DatagramPacket
          import java.net.DatagramSocket
          import java.net.InetSocketAddress
          import java.net.ServerSocket
          import java.net.Socket
          import java.util.concurrent.atomic.AtomicInteger
          import kotlin.concurrent.thread

          class ChatService : Service() {

              companion object {
                  const val CH_SVC = "svc"
                  const val CH_MSG = "msg"
                  const val FIRST_MSG_NOTIF = 100

                  @Volatile
                  var listener: ((Msg) -> Unit)? = null

                  @Volatile
                  var appVisible = false
              }

              @Volatile
              private var running = true
              private var udp: DatagramSocket? = null
              private var tcp: ServerSocket? = null
              private var mcLock: WifiManager.MulticastLock? = null
              private var wakeLock: PowerManager.WakeLock? = null
              private val seen = LinkedHashSet<String>()
              private val notifId = AtomicInteger(FIRST_MSG_NOTIF)

              override fun onBind(intent: Intent?): IBinder? = null

              override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int = START_STICKY

              override fun onCreate() {
                  super.onCreate()
                  createChannels()
                  val n = Notification.Builder(this, CH_SVC)
                      .setSmallIcon(android.R.drawable.stat_notify_chat)
                      .setContentTitle("تطبيق عبدالله")
                      .setContentText("يستقبل الرسائل في الخلفية")
                      .setOngoing(true)
                      .setContentIntent(openAppIntent())
                      .build()
                  if (Build.VERSION.SDK_INT >= 29) {
                      startForeground(1, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC)
                  } else {
                      startForeground(1, n)
                  }

                  try {
                      val wm = applicationContext.getSystemService(Context.WIFI_SERVICE) as WifiManager
                      mcLock = wm.createMulticastLock("lanchat").apply {
                          setReferenceCounted(false)
                          acquire()
                      }
                  } catch (_: Exception) {
                  }
                  try {
                      val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
                      wakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "lanchat:service").apply {
                          setReferenceCounted(false)
                          acquire()
                      }
                  } catch (_: Exception) {
                  }

                  thread(isDaemon = true) { receiveLoop() }
                  thread(isDaemon = true) { serveLoop() }
              }

              private fun createChannels() {
                  val nm = getSystemService(NotificationManager::class.java)
                  nm.createNotificationChannel(
                      NotificationChannel(CH_SVC, "الخدمة", NotificationManager.IMPORTANCE_LOW)
                  )
                  nm.createNotificationChannel(
                      NotificationChannel(CH_MSG, "الرسائل", NotificationManager.IMPORTANCE_HIGH)
                  )
              }

              private fun openAppIntent(): PendingIntent {
                  val i = Intent(this, MainActivity::class.java)
                      .addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_NEW_TASK)
                  return PendingIntent.getActivity(
                      this, 0, i, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
                  )
              }

              private fun receiveLoop() {
                  while (running) {
                      try {
                          val s = DatagramSocket(null)
                          s.reuseAddress = true
                          s.broadcast = true
                          s.bind(InetSocketAddress(Net.UDP_PORT))
                          udp = s
                          val buf = ByteArray(8192)
                          while (running) {
                              val p = DatagramPacket(buf, buf.size)
                              s.receive(p)
                              try {
                                  handle(p)
                              } catch (_: Exception) {
                              }
                          }
                      } catch (_: Exception) {
                          if (running) Thread.sleep(2000)
                      }
                  }
              }

              private fun handle(p: DatagramPacket) {
                  val raw = String(p.data, 0, p.length, Charsets.UTF_8)
                  val a = raw.split(Net.SEP, limit = 6)
                  if (a.size != 6 || a[0] != Net.MAGIC) return
                  val msgId = a[1]
                  val sender = a[2]
                  val kind = a[3]
                  val name = a[4]
                  val payload = a[5]
                  if (sender == Net.myId) return
                  synchronized(seen) {
                      if (!seen.add(msgId)) return
                      if (seen.size > 300) seen.remove(seen.first())
                  }
                  val host = p.address.hostAddress ?: return
                  when (kind) {
                      "T" -> deliver(Msg(false, name, payload, "", Store.now()))
                      "I" -> {
                          if (!payload.matches(Regex("[A-Za-z0-9]{1,32}"))) return
                          thread(isDaemon = true) {
                              var ok = false
                              var tries = 0
                              while (!ok && tries < 3) {
                                  tries++
                                  ok = try {
                                      fetchImage(host, payload)
                                  } catch (_: Exception) {
                                      false
                                  }
                                  if (!ok) Thread.sleep(500)
                              }
                              if (ok) deliver(Msg(false, name, "", payload, Store.now()))
                          }
                      }
                  }
              }

              private fun fetchImage(host: String, imgId: String): Boolean {
                  Socket().use { sock ->
                      sock.connect(InetSocketAddress(host, Net.TCP_PORT), 5000)
                      sock.soTimeout = 15000
                      val os = sock.getOutputStream()
                      os.write((imgId + "\n").toByteArray(Charsets.UTF_8))
                      os.flush()
                      val dir = File(filesDir, "img")
                      dir.mkdirs()
                      val f = File(dir, "$imgId.jpg")
                      FileOutputStream(f).use { out -> sock.getInputStream().copyTo(out) }
                      return f.length() > 0
                  }
              }

              private fun serveLoop() {
                  while (running) {
                      try {
                          val ss = ServerSocket()
                          ss.reuseAddress = true
                          ss.bind(InetSocketAddress(Net.TCP_PORT))
                          tcp = ss
                          while (running) {
                              val c = ss.accept()
                              thread(isDaemon = true) { serve(c) }
                          }
                      } catch (_: Exception) {
                          if (running) Thread.sleep(2000)
                      }
                  }
              }

              private fun serve(c: Socket) {
                  try {
                      c.use { sock ->
                          sock.soTimeout = 10000
                          val id = sock.getInputStream().bufferedReader().readLine() ?: return
                          if (!id.matches(Regex("[A-Za-z0-9]{1,32}"))) return
                          val f = File(File(filesDir, "img"), "$id.jpg")
                          if (!f.exists()) return
                          val os = sock.getOutputStream()
                          f.inputStream().use { inp -> inp.copyTo(os) }
                          os.flush()
                      }
                  } catch (_: Exception) {
                  }
              }

              private fun deliver(m: Msg) {
                  Store.append(this, m)
                  notifyMsg(m)
                  listener?.invoke(m)
              }

              private fun notifyMsg(m: Msg) {
                  if (appVisible) return
                  val body = if (m.imgId.isNotEmpty()) "📷 صورة" else m.text
                  val n = Notification.Builder(this, CH_MSG)
                      .setSmallIcon(android.R.drawable.stat_notify_chat)
                      .setContentTitle(m.name)
                      .setContentText(body)
                      .setContentIntent(openAppIntent())
                      .setAutoCancel(true)
                      .build()
                  try {
                      val nm = getSystemService(NotificationManager::class.java)
                      nm.notify(notifId.getAndIncrement(), n)
                  } catch (_: Exception) {
                  }
              }

              override fun onDestroy() {
                  running = false
                  try {
                      udp?.close()
                  } catch (_: Exception) {
                  }
                  try {
                      tcp?.close()
                  } catch (_: Exception) {
                  }
                  try {
                      mcLock?.release()
                  } catch (_: Exception) {
                  }
                  try {
                      wakeLock?.release()
                  } catch (_: Exception) {
                  }
                  super.onDestroy()
              }
          }
          LANCHAT_EOF
          mkdir -p app/src/main/java/com/lanchat
          cat > app/src/main/java/com/lanchat/MainActivity.kt <<'LANCHAT_EOF'
          package com.lanchat

          import android.Manifest
          import android.app.Activity
          import android.app.NotificationManager
          import android.content.Context
          import android.content.Intent
          import android.content.pm.PackageManager
          import android.graphics.Bitmap
          import android.graphics.BitmapFactory
          import android.graphics.Color
          import android.graphics.Matrix
          import android.graphics.Typeface
          import android.graphics.drawable.GradientDrawable
          import android.media.ExifInterface
          import android.net.Uri
          import android.os.Build
          import android.os.Bundle
          import android.os.PowerManager
          import android.provider.Settings
          import android.view.Gravity
          import android.view.View
          import android.view.inputmethod.EditorInfo
          import android.widget.Button
          import android.widget.EditText
          import android.widget.ImageView
          import android.widget.LinearLayout
          import android.widget.ScrollView
          import android.widget.TextView
          import android.widget.Toast
          import java.io.File
          import java.io.FileOutputStream
          import kotlin.concurrent.thread

          class MainActivity : Activity() {

              private val pickImage = 7

              private lateinit var list: LinearLayout
              private lateinit var scroll: ScrollView
              private lateinit var nameBox: EditText
              private lateinit var msgBox: EditText

              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  buildUi()
                  if (Build.VERSION.SDK_INT >= 33 &&
                      checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
                  ) {
                      requestPermissions(arrayOf(Manifest.permission.POST_NOTIFICATIONS), 1)
                  }
                  try {
                      startForegroundService(Intent(this, ChatService::class.java))
                  } catch (e: Exception) {
                      Toast.makeText(this, "تعذر تشغيل الخدمة: " + e.message, Toast.LENGTH_LONG).show()
                  }
              }

              override fun onStart() {
                  super.onStart()
                  ChatService.appVisible = true
                  list.removeAllViews()
                  for (m in Store.load(this)) addMsg(m)
                  ChatService.listener = { m -> runOnUiThread { addMsg(m) } }
                  try {
                      val nm = getSystemService(NotificationManager::class.java)
                      for (sn in nm.activeNotifications) {
                          if (sn.id >= ChatService.FIRST_MSG_NOTIF) nm.cancel(sn.id)
                      }
                  } catch (_: Exception) {
                  }
              }

              override fun onStop() {
                  ChatService.appVisible = false
                  ChatService.listener = null
                  super.onStop()
              }

              private fun dp(v: Int): Int = (v * resources.displayMetrics.density).toInt()

              private fun buildUi() {
                  val match = LinearLayout.LayoutParams.MATCH_PARENT
                  val wrap = LinearLayout.LayoutParams.WRAP_CONTENT

                  val root = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      setBackgroundColor(Color.parseColor("#ECE5DD"))
                  }

                  val title = TextView(this).apply {
                      this.text = "💬 تطبيق عبدالله"
                      setTextColor(Color.WHITE)
                      textSize = 20f
                      setPadding(dp(16), dp(14), dp(8), dp(14))
                  }
                  val batteryBtn = TextView(this).apply {
                      this.text = "🔋"
                      textSize = 22f
                      setPadding(dp(14), dp(10), dp(14), dp(10))
                      setOnClickListener { askBattery() }
                  }
                  val header = LinearLayout(this).apply {
                      orientation = LinearLayout.HORIZONTAL
                      gravity = Gravity.CENTER_VERTICAL
                      setBackgroundColor(Color.parseColor("#075E54"))
                      addView(title, LinearLayout.LayoutParams(0, wrap, 1f))
                      addView(batteryBtn, LinearLayout.LayoutParams(wrap, wrap))
                  }

                  val prefs = getSharedPreferences("chat", MODE_PRIVATE)
                  nameBox = EditText(this).apply {
                      hint = "اسمك"
                      setSingleLine(true)
                      setText(prefs.getString("name", ""))
                      setPadding(dp(16), dp(12), dp(16), dp(12))
                  }

                  list = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      setPadding(dp(8), dp(8), dp(8), dp(8))
                  }
                  scroll = ScrollView(this).apply { addView(list) }

                  msgBox = EditText(this).apply {
                      hint = "اكتب رسالة..."
                      setSingleLine(true)
                      imeOptions = EditorInfo.IME_ACTION_SEND
                      setOnEditorActionListener { _, actionId, _ ->
                          if (actionId == EditorInfo.IME_ACTION_SEND) {
                              sendText()
                              true
                          } else {
                              false
                          }
                      }
                  }
                  val photoBtn = Button(this).apply {
                      this.text = "📷"
                      setOnClickListener { choosePhoto() }
                  }
                  val sendBtn = Button(this).apply {
                      this.text = "إرسال"
                      setOnClickListener { sendText() }
                  }
                  val row = LinearLayout(this).apply {
                      orientation = LinearLayout.HORIZONTAL
                      setPadding(dp(8), dp(4), dp(8), dp(4))
                      addView(photoBtn, LinearLayout.LayoutParams(wrap, wrap))
                      addView(msgBox, LinearLayout.LayoutParams(0, wrap, 1f))
                      addView(sendBtn, LinearLayout.LayoutParams(wrap, wrap))
                  }

                  root.addView(header, LinearLayout.LayoutParams(match, wrap))
                  root.addView(nameBox, LinearLayout.LayoutParams(match, wrap))
                  root.addView(scroll, LinearLayout.LayoutParams(match, 0, 1f))
                  root.addView(row, LinearLayout.LayoutParams(match, wrap))
                  setContentView(root)
              }

              private fun askBattery() {
                  try {
                      val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
                      if (pm.isIgnoringBatteryOptimizations(packageName)) {
                          Toast.makeText(this, "تحسين البطارية معطّل مسبقاً للتطبيق ✅", Toast.LENGTH_LONG).show()
                      } else {
                          val i = Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS)
                          i.data = Uri.parse("package:" + packageName)
                          startActivity(i)
                      }
                  } catch (e: Exception) {
                      Toast.makeText(this, "افتح إعدادات البطارية للتطبيق يدوياً", Toast.LENGTH_LONG).show()
                  }
              }

              private fun currentName(): String {
                  val typed = nameBox.text.toString().trim()
                  getSharedPreferences("chat", MODE_PRIVATE).edit().putString("name", typed).apply()
                  return if (typed.isEmpty()) "مجهول" else typed
              }

              private fun sendText() {
                  val body = msgBox.text.toString().trim()
                  if (body.isEmpty()) return
                  val who = currentName()
                  msgBox.setText("")
                  val m = Msg(true, who, body, "", Store.now())
                  Store.append(this, m)
                  addMsg(m)
                  Net.broadcast(this, Net.packet(Net.newId(), "T", who, body))
              }

              private fun choosePhoto() {
                  val i = Intent(Intent.ACTION_GET_CONTENT)
                  i.type = "image/*"
                  i.addCategory(Intent.CATEGORY_OPENABLE)
                  startActivityForResult(i, pickImage)
              }

              override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
                  super.onActivityResult(requestCode, resultCode, data)
                  if (requestCode != pickImage || resultCode != RESULT_OK) return
                  val uri = data?.data ?: return
                  val who = currentName()
                  thread {
                      val bmp = try {
                          loadScaled(uri, 1024)
                      } catch (_: Exception) {
                          null
                      }
                      if (bmp == null) {
                          runOnUiThread {
                              Toast.makeText(this, "تعذر قراءة الصورة", Toast.LENGTH_LONG).show()
                          }
                          return@thread
                      }
                      val id = Net.newId()
                      val dir = File(filesDir, "img")
                      dir.mkdirs()
                      FileOutputStream(File(dir, "$id.jpg")).use { out ->
                          bmp.compress(Bitmap.CompressFormat.JPEG, 70, out)
                      }
                      val m = Msg(true, who, "", id, Store.now())
                      Store.append(this, m)
                      runOnUiThread { addMsg(m) }
                      Net.broadcast(this, Net.packet(Net.newId(), "I", who, id))
                  }
              }

              private fun loadScaled(uri: Uri, maxSide: Int): Bitmap? {
                  val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
                  contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) }
                  var sample = 1
                  while (bounds.outWidth / sample > maxSide * 2 || bounds.outHeight / sample > maxSide * 2) {
                      sample *= 2
                  }
                  val opts = BitmapFactory.Options().apply { inSampleSize = sample }
                  val src = contentResolver.openInputStream(uri)?.use {
                      BitmapFactory.decodeStream(it, null, opts)
                  } ?: return null

                  val orientation = try {
                      contentResolver.openInputStream(uri)?.use {
                          ExifInterface(it).getAttributeInt(
                              ExifInterface.TAG_ORIENTATION,
                              ExifInterface.ORIENTATION_NORMAL
                          )
                      } ?: ExifInterface.ORIENTATION_NORMAL
                  } catch (_: Exception) {
                      ExifInterface.ORIENTATION_NORMAL
                  }
                  val degrees = when (orientation) {
                      ExifInterface.ORIENTATION_ROTATE_90 -> 90f
                      ExifInterface.ORIENTATION_ROTATE_180 -> 180f
                      ExifInterface.ORIENTATION_ROTATE_270 -> 270f
                      else -> 0f
                  }
                  val scale = minOf(1f, maxSide.toFloat() / maxOf(src.width, src.height))
                  val m = Matrix()
                  m.postScale(scale, scale)
                  if (degrees != 0f) m.postRotate(degrees)
                  return Bitmap.createBitmap(src, 0, 0, src.width, src.height, m, true)
              }

              private fun addMsg(m: Msg) {
                  val box = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      setPadding(dp(12), dp(8), dp(12), dp(8))
                      background = GradientDrawable().apply {
                          cornerRadius = dp(10).toFloat()
                          setColor(Color.parseColor(if (m.mine) "#DCF8C6" else "#FFFFFF"))
                      }
                  }
                  val who = TextView(this).apply {
                      this.text = m.name
                      setTextColor(Color.parseColor("#075E54"))
                      textSize = 13f
                      setTypeface(null, Typeface.BOLD)
                  }
                  box.addView(who)

                  if (m.imgId.isNotEmpty()) {
                      val f = File(File(filesDir, "img"), m.imgId + ".jpg")
                      val bmp = if (f.exists()) BitmapFactory.decodeFile(f.absolutePath) else null
                      if (bmp != null) {
                          val iv = ImageView(this).apply {
                              setImageBitmap(bmp)
                              adjustViewBounds = true
                              maxWidth = dp(240)
                          }
                          box.addView(iv)
                      } else {
                          box.addView(TextView(this).apply { this.text = "(الصورة غير متاحة)" })
                      }
                  }
                  if (m.text.isNotEmpty()) {
                      box.addView(TextView(this).apply {
                          this.text = m.text
                          setTextColor(Color.BLACK)
                          textSize = 16f
                      })
                  }
                  box.addView(TextView(this).apply {
                      this.text = m.time
                      textSize = 10f
                      setTextColor(Color.GRAY)
                  })

                  val lp = LinearLayout.LayoutParams(
                      LinearLayout.LayoutParams.WRAP_CONTENT,
                      LinearLayout.LayoutParams.WRAP_CONTENT
                  )
                  lp.setMargins(0, dp(4), 0, dp(4))
                  lp.gravity = if (m.mine) Gravity.END else Gravity.START
                  list.addView(box, lp)
                  scroll.post { scroll.fullScroll(View.FOCUS_DOWN) }
              }
          }
